# Copy to .env (or export directly) before running the backend.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default model
# SUPPORT_AGENT_MODEL=claude-sonnet-4-5-20250929

# Optional: protects /api/admin/* endpoints (see DEPLOY.md)
# ADMIN_API_TOKEN=some-long-random-string

# Optional: read order/customer/return test data from a published Google
# Sheet instead of the local mock_data/*.json files. Leave unset to use
# the local files. See docs/GOOGLE_SHEETS_SETUP.md.
# ORDERS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=0&single=true&output=csv
# CUSTOMERS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=.../single=true&output=csv
# RETURNS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=.../single=true&output=csv
